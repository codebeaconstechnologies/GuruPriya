# Server-side only — configure these as Cloudflare Pages secrets.
# NEVER prefix with VITE_ and never reference from client code:
# doing so would bundle the secret into the browser JavaScript.

RESEND_API_KEY=
CONTACT_EMAIL=
FROM_EMAIL=


# Build-time settings (plain variables in Cloudflare Pages).
SITE_URL=https://www.gurupriyatours.com
# Google Tag Manager container (default GTM-TVQX9W8K; GA4 is configured inside GTM).
GTM_CONTAINER_ID=
GOOGLE_SITE_VERIFICATION=
