{
  "name": "gurupriya-tours-travels",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "deploy:staging": "npm run build && npx -y wrangler@4 deploy --config wrangler.staging.jsonc",
    "deploy:production": "npm run build && npx -y wrangler@4 pages deploy dist --project-name gurupriya --branch main"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
